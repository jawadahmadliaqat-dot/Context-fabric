{"description":"Declarative policies for context-fabric. Structure mirrors AWS Cedar (principal / action / resource / condition, Permit vs Forbid, Forbid overrides Permit, default DENY) but this file is NOT Cedar and is not parsed by Cedar. See INTERFACE.md for the mapping.","policies":[{"action":["*"],"allowed_capabilities":["*"],"condition":{"user_present":true},"description":"Owner who is present can do everything.","effect":"Permit","id":"owner_present_permit_all","principal":{"user_role":"OWNER"},"resource":["*"]},{"action":["ToggleLight","TurnOnLight","TurnOffLight"],"allowed_capabilities":["livingroom.lights.toggle"],"condition":{"ambient_state":["HOME"],"user_present":true},"description":"Guest can toggle LivingRoom Lights while HOME.","effect":"Permit","id":"guest_livingroom_lights_permit","principal":{"user_role":"GUEST"},"resource":["LivingRoomLights"]},{"action":["UnlockDoor"],"allowed_capabilities":[],"condition":{},"description":"Guest cannot unlock SmartLock.","effect":"Forbid","id":"guest_smartlock_forbid","principal":{"user_role":"GUEST"},"resource":["SmartLock"]},{"action":["ModifyHeater"],"allowed_capabilities":[],"condition":{},"description":"Guest cannot modify Heaters.","effect":"Forbid","id":"guest_heater_forbid","principal":{"user_role":"GUEST"},"resource":["Heater","LivingRoomHeater","BedroomHeater"]},{"action":["UnlockDoor","LockDoor","ModifyHeater","ToggleLight","TurnOnLight","TurnOffLight"],"allowed_capabilities":[],"condition":{},"description":"UNKNOWN actor can do nothing sensitive.","effect":"Forbid","id":"unknown_no_sensitive","principal":{"user_role":"UNKNOWN"},"resource":["*"]},{"action":["UnlockDoor"],"allowed_capabilities":[],"condition":{"ambient_state":["AWAY"],"user_present":false},"description":"Nobody unlocks when AWAY and no user is present (this Forbid overrides the Owner permit; Owner present is the exception because then user_present is true and this rule does not match).","effect":"Forbid","id":"away_no_unlock_when_absent","principal":{"user_role":"*"},"resource":["SmartLock"]},{"action":["ModifyHeater"],"allowed_capabilities":[],"condition":{"ambient_state":["SLEEP"]},"description":"Guest cannot change Heater during SLEEP (redundant with guest_heater_forbid, kept explicit for audit).","effect":"Forbid","id":"sleep_guest_heater_forbid","principal":{"user_role":"GUEST"},"resource":["Heater","LivingRoomHeater","BedroomHeater"]}],"version":"1.0"}